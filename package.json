{
  "name": "elbi-study-hub-pass1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npx tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "assets": "python scripts/assets/build_assets.py",
    "assets:watch": "python scripts/assets/watch_assets.py",
    "validate:assets": "python scripts/validate/validate_assets.py",
    "preview:static": "python -m http.server 4174 -d preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts",
    "test:domain": "bash scripts/validate/run_domain_tests.sh",
    "test:visual": "python tests/e2e/visual_harness.py",
    "test:mobile": "python tests/e2e/mobile_visual.py",
    "qa:local": "npm run assets && npm run validate:assets && npm run validate:living && npm run validate:pixel-snap && npm run validate:determinism && npm run validate:syntax && npm run test:domain && npm run test:visual && npm run test:mobile && npm run test:living-visual && npm run validate:scope",
    "art:bootstrap-living": "python scripts/assets/bootstrap_living_concept.py",
    "art:snap": "python scripts/assets/pixel_snap.py",
    "art:snap:all": "python scripts/assets/pixel_snap.py all",
    "art:snap:strict": "python scripts/assets/pixel_snap.py all --strict",
    "art:promote": "python scripts/assets/promote_snapped.py",
    "validate:pixel-snap": "python scripts/validate/validate_pixel_snap.py",
    "validate:living": "python scripts/validate/validate_living_elbi.py",
    "test:living-visual": "python tests/e2e/living_visual.py",
    "validate:scope": "python scripts/validate/scope_audit.py",
    "validate:syntax": "node scripts/validate/transpile_syntax.cjs",
    "validate:determinism": "python scripts/validate/validate_determinism.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.8.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript-eslint": "8.67.0"
  }
}

[meta]
version = "1"

[output]
name = "campus-atlas"
directory = "assets/generated/atlases/"
texture_format = "png"
pixel_format = "rgba8888"
data_format = "phaser3"
quality = 100

[layout]
max_width = 1024
max_height = 1024
size_constraint = "any"
force_square = false
allow_rotation = false
pack_mode = "good"
border_padding = 2
shape_padding = 2

[sprites]
trim_mode = "trim"
trim_threshold = 1
extrude = 1
detect_aliases = true

[algorithm]
type = "max_rects"
heuristic = "best_short_side_fit"

[[sources]]
path = "assets/exports/sprites/"
filter = "*.png"

[[sources]]
path = "assets/exports/living-sprites/"
filter = "*.png"
